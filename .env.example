# Supabase (PostgreSQL) — existing
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Server-side Supabase — get from Supabase Dashboard > Project Settings > API > service_role
# Required for secure enrollment writes; if missing, app falls back to publishable key but RLS policies allow it
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Razorpay — get from https://dashboard.razorpay.com/app/keys (Test Mode first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Optional: also expose key to client via public var (if you prefer NEXT_PUBLIC_ prefix)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# Do NOT expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to frontend
